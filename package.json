{
  "name": "@iyulab/data-components",
  "description": "Data elements for Lit apps: rich table, simple sheet and record picker",
  "version": "0.57.0",
  "keywords": [
    "iyulab",
    "web-components",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-data-components.git"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": "./src/*",
    "./init": "./src/init.js",
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    },
    "./simple-sheet": "./src/components/simple-sheet/USimpleSheet.js",
    "./data-view": "./src/components/data-view/UDataView.js",
    "./u-rich-table": "./src/components/u-rich-table/URichTable.js",
    "./u-record-picker": "./src/components/u-record-picker/URecordPicker.js"
  },
  "sideEffects": [
    "./dist/components/data-view/UDataView.js",
    "./src/components/data-view/UDataView.ts",
    "./dist/components/simple-sheet/USimpleSheet.js",
    "./src/components/simple-sheet/USimpleSheet.ts",
    "./dist/components/u-rich-table/URichTable.js",
    "./src/components/u-rich-table/URichTable.ts",
    "./dist/components/u-record-picker/URecordPicker.js",
    "./src/components/u-record-picker/URecordPicker.ts",
    "./dist/index.js",
    "./src/index.ts",
    "./dist/init.js",
    "./src/init.ts",
    "./dist/react.js",
    "./src/react.ts",
    "./dist/utilities/shadowDomProtection.js",
    "./src/utilities/shadowDomProtection.ts"
  ],
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite",
    "analyze": "cem analyze",
    "build": "npm run typecheck && eslint && vite build && npm run analyze",
    "pretest": "node -e \"if(require('fs').existsSync('../../scripts/sibling-dist-check.js'))require('child_process').execFileSync('node',['../../scripts/sibling-dist-check.js'],{stdio:'inherit'})\"",
    "test": "vitest run --project=unit --project=browser",
    "test:webkit": "vitest run --project=webkit",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@iyulab/components": ">=3.2.0",
    "@lit/react": "^1.0.8",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@iyulab/components": "^3.0.0",
    "@lit/react": "^1.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
